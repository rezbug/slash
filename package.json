{
  "name": "slash",
  "version": "0.2.0",
  "description": "htm + hyper + reactive signals (no VDOM) — tiny, fast, DX-first",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./router": {
      "bun": "./src/router/index.ts",
      "types": "./dist/types/router/index.d.ts",
      "import": "./dist/router/index.mjs",
      "require": "./dist/router/index.cjs",
      "default": "./dist/router/index.mjs"
    }
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build:types": "tsc -p ./tsconfig.json",
    "build:esm": "FORMAT=esm NODE_ENV=production bun run scripts/build.ts && FORMAT=esm NODE_ENV=production bun run scripts/build-router.ts",
    "build:cjs": "FORMAT=cjs NODE_ENV=production bun run scripts/build.ts && FORMAT=cjs NODE_ENV=production bun run scripts/build-router.ts",
    "build": "bun run clean && bun run build:esm && bun run build:cjs",
    "dev:bundle": "FORMAT=esm NODE_ENV=development bun run scripts/build.ts --watch",
    "dev:types": "tsc -w -p ./tsconfig.json --preserveWatchOutput",
    "dev": "concurrently --kill-others --names \"types,bundle\" \"bun run dev:types\" \"bun run dev:bundle\"",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "htm": "^3.1.1"
  },
  "peerDependencies": {
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@happy-dom/global-registrator": "^20.3.1",
    "@types/bun": "latest",
    "@types/node": "^24.5.0",
    "bun-types": "^1.3.3",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.3.1",
    "typescript": "^5.6.2"
  }
}