{
  "name": "slash",
  "version": "0.2.0",
  "description": "htm + hyper + reactive signals (no VDOM) — tiny, fast, DX-first",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs",
      "bun": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build",
    "dev": "bun run scripts/dev.ts",
    "release": "standard-version -p conventionalcommits"
  },
  "dependencies": {
    "htm": "^3.1.1"
  },
  "peerDependencies": {
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.5.0",
    "bun-types": "^1.3.3",
    "typescript": "^5.6.2"
  }
}
